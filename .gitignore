# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-audit/
/out/

# production
/build
/.build

# misc
.DS_Store
*.pem

# env files - keep real secrets on the server, not in git
.env
.env.production
.env*.local
!.env.example

# Office lock files and spreadsheet inspection output
~$*
*.inspect.ndjson

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
*.log

# python (one-off data scripts)
__pycache__/
*.pyc

# scratch output from one-off scripts and reports (scripts/scan_editorial_product_content.mjs writes to tmp/)
/tmp/
/outputs/



# vercel
.vercel

# editor
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts
.next-verify
.next-after
