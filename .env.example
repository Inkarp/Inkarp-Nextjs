# --- MongoDB ---
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name to use (created automatically on first insert if it doesn't exist).
MONGODB_DB=inkarp

# --- Outgoing mail (nodemailer) ---
# SMTP credentials used to send form-submission notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address notifications are sent "from" (often must match SMTP_USER for many providers).
MAIL_FROM=
# Address every form submission is sent to.
MAIL_TO=sharath@inkarp.co.in

# Dexter assistant (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=

# Free-tier conversational engine (used when no Anthropic key is set)
GROQ_API_KEY=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
GROQ_MODEL=

# Passwordless sign-in — any random string of 32+ characters
AUTH_SECRET=db56df337c5b816190f0c36f89198c810f17be095cd438e9516dedcb682fcc58
SITE_URL=
