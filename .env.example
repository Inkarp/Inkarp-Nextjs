# --- MongoDB ---
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name to use (created automatically on first insert if it doesn't exist).
MONGODB_DB=inkarp

# --- Outgoing mail (nodemailer) ---
# SMTP credentials used to send form-submission notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address notifications are sent "from" (often must match SMTP_USER for many providers).
MAIL_FROM=
# Address every form submission is sent to.
MAIL_TO=sharath@inkarp.co.in
